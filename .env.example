# Copiar a .env y ajustar. El archivo .env NO se versiona.

# Clave de firma de Django. Generar una propia con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=cambiar-esta-clave-en-cada-entorno

# Base de datos. SQLite por defecto, tal como pide el enunciado.
DATABASE_URL=sqlite:///db.sqlite3

# Hosts autorizados (obligatorio en producción, sin valor por defecto).
ALLOWED_HOSTS=localhost,127.0.0.1

# URL de la API que consume la interfaz NiceGUI.
API_BASE_URL=http://127.0.0.1:8000/api/v1

# Clave de firma del almacenamiento de sesión de NiceGUI.
NICEGUI_STORAGE_SECRET=cambiar-esta-clave-tambien

# Solo producción: activa redirección HTTPS, HSTS y cookies seguras.
SECURE_HTTPS=False
