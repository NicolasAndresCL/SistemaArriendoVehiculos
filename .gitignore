# Entorno virtual propio del subproyecto
.venv/

# Base de datos local: se regenera con migrate + seed_demo
db.sqlite3
db.sqlite3-journal

# Secretos
.env

# Cachés de herramientas
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# Estado de sesión que NiceGUI crea al ejecutarse
.nicegui/

# Bitácora personal de hitos para portafolio (no es documentación del proyecto)
memory.md

# Registro local de trabajo pendiente (no es documentación del proyecto)
pendientes.md

# Estáticos recolectados: los genera collectstatic en el despliegue
staticfiles/

# Base desechable del chequeo de hardening
db-check.sqlite3

# Terraform: el estado guarda secretos EN CLARO y nunca se versiona.
# El lock SÍ se versiona (fija las versiones de proveedor), por eso la excepción.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
backend.hcl
tfplan

# Artefactos de pruebas con navegador
.playwright-mcp/

# Lecciones por tecnología (documento personal, no es documentación del proyecto)
aprendizaje.md
